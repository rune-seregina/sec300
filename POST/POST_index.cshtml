@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-left">
    <h1 class="display-4">First Inputs</h1>
    <p>Here is the first form to be submitted:</p>
    
    <form method="post">
        <!--Here is a text box -->
        <label for="firstName">First Name:</label>
        <input asp-for="firstName" class="item" type="text" placeholder="Jane Doe">
        
        <br><br>
        <!--Here is a menu-->
        <label for="preference">I like: </label>
        <select asp-for="preference" class="item">
            <option value="">Choose one</option>
            <option value="ASP">ASP</option>
            <option value="PHP">PHP</option>
            <option value="JSP">JSP</option>
        </select>

        <br><br>
        <!--The button to submit-->
        <button type="submit" class="form-textbox">Submit</button>
    </form>

    <div class="text-left"> Your Selections
        <br><br>
        First name: @Model.firstName
        <br><br>
        Preference: @Model.preference
    </div>
</div>
